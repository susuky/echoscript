# Copy this file to .env and adjust local settings.
ECHOSCRIPT_DATA_DIR=~/.local/share/echoscript
ECHOSCRIPT_WEB_HOST=0.0.0.0
ECHOSCRIPT_WEB_PORT=7860
# Optional for speaker diarization; a token saved by `hf auth login` is also detected.
HF_TOKEN=
ECHOSCRIPT_RELEASE_BETWEEN_STAGES=true
ECHOSCRIPT_MODEL_IDLE_TIMEOUT_SECONDS=300
ECHOSCRIPT_MAX_UPLOAD_BYTES=2147483648
ECHOSCRIPT_MAX_MEDIA_DURATION_SECONDS=43200
ECHOSCRIPT_JOB_RETENTION_DAYS=30
